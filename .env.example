# ===== 模型网关密钥 =====
# 不配置任何密钥时，系统自动使用「免费演示模型」(demo)，可完整体验流式对话。
# 配置任一密钥后，即可在界面右上角模型选择器中切换对应真实模型。

# —— 海外模型 ——
# OpenAI (GPT 系列): https://platform.openai.com
OPENAI_API_KEY=
# Anthropic (Claude 系列): https://console.anthropic.com
ANTHROPIC_API_KEY=
# fal.ai (FLUX.1 Schnell/Dev 绘图 + 图生图): https://fal.ai/dashboard/keys
FAL_KEY=

# —— 国内模型 ——
# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# 阿里云百炼 DashScope (Qwen 对话 + 通义万相绘图): https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# 说明：
# - 对话模型：OpenAI / Anthropic / DeepSeek / DashScope 任一即可
# - 绘图模型：OPENAI_API_KEY(DALL·E 3)、DASHSCOPE_API_KEY(通义万相/图生图) 或 FAL_KEY(FLUX 快速版/图生图)
# - 背景移除：REMOVE_BG_API_KEY（可选；不配置时前端自动用本地 AI 去背景，免费但首次需加载模型）
# - 不配密钥时自动使用免费演示模式（对话/PPT/绘图均可完整体验）

# ===== 第三方登录（Google / GitHub OAuth，可选）=====
# 在各自控制台创建 OAuth 应用，回调地址填写：
#   https://你的域名/api/auth/oauth/google/callback
#   https://你的域名/api/auth/oauth/github/callback
# 本地开发时需公网地址（可用内网穿透）；OAUTH_REDIRECT_BASE 默认取当前域名，
# 若部署在代理后面可显式指定，例如 https://your-domain.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=

# ===== 深度研究（联网搜索）=====
# Tavily: https://tavily.com （也可在前台「模型设置」里填，无需重启）
TAVILY_API_KEY=
# 背景移除（可选，remove.bg）
REMOVE_BG_API_KEY=
# 数据库 / 支付 / 认证
DATABASE_URL=postgresql://user:password@localhost:5432/opencanvas  # 生产切换用（开发无需配置，见 docs/POSTGRES.md）
STRIPE_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ===== 网关增强（可选）=====
# 跨供应商自动降级：上游失败且未输出任何内容时，沿模型 fallback 链切换供应商
# 默认链：gpt-4o-mini → deepseek-chat → qwen-plus；gpt-4o/claude-3.5 → qwen-max → qwen-plus
GATEWAY_FALLBACK=1
# 限流：每用户每分钟最大请求数（未登录按 IP），0 = 关闭，默认 60
GATEWAY_RATE_LIMIT=60
# 多 API Key 轮询：逗号分隔，401/429 自动换下一个 key 重试（各供应商同款 *_KEYS）
OPENAI_API_KEYS=
ANTHROPIC_API_KEYS=
DEEPSEEK_API_KEYS=
DASHSCOPE_API_KEYS=
# 成本看板「全局视角」管理密钥（设置中心 → 模型设置 → 用量与成本看板）
GATEWAY_ADMIN_KEY=
