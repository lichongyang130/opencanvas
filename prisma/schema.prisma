// Prisma 数据模型
// 开发环境：SQLite（零外部服务，开箱即用）
// 生产环境：把 provider 改为 "postgresql" 并设置 DATABASE_URL 即可，业务代码无需改动。
// 第 2 阶段会在这些表基础上扩展用户体系（当前为单用户本地版）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id            String    @id
  title         String    @default("新任务")
  mode          String    @default("chat") // chat/research/slides/image/video/docs
  model         String    @default("demo") // 使用的模型 id
  modelProvider String?   // 动态模型对应的供应商
  deck          String?   // PPT 产物 JSON (SlideDeck)
  deckStatus    String?   // idle/loading/done/error
  images        String?   // 图像产物 JSON (StoredImage[])
  report        String?   // 研究报告 JSON (ResearchReport)
  doc           String?   // 文档产物 JSON (UIDoc)
  personaId     String?   // 绑定的 AI 角色 id
  archived      Boolean   @default(false)
  pinned        Boolean   @default(false)
  createdAt     Float
  updatedAt     Float
  messages      Message[]

  @@index([updatedAt])
}

model Message {
  id             String       @id
  conversationId String
  role           String // user / assistant
  content        String
  error          Boolean      @default(false)
  createdAt      Float
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
